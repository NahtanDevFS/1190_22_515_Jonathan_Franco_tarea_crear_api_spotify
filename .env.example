NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://music:music@127.0.0.1:5433/musicapi?schema=public"

JWT_ACCESS_SECRET=cambia_este_secreto_access
JWT_REFRESH_SECRET=cambia_este_secreto_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# Seed (npm run seed): crea el administrador inicial. La contraseña debe tener 8+ caracteres, letra y número.
ADMIN_CORREO=admin@ejemplo.com
ADMIN_NOMBRE_USUARIO=admin
ADMIN_CONTRASENA=CambiaEsto123
# true = además crea un artista, álbum y canciones de ejemplo (nunca en producción)
SEED_DATOS_DEMO=true
